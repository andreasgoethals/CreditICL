# ---------------------------------------------------------------------------
# Line endings.
#
# The important rule is the shell one. We edit on Windows and run on Linux; a
# .slurm or .sh file that reaches the cluster with CRLF fails immediately with
#   /bin/bash^M: bad interpreter: No such file or directory
# which is an obscure error to debug at 11pm. Force LF on everything the cluster
# executes or reads.
# ---------------------------------------------------------------------------

* text=auto eol=lf

*.slurm  text eol=lf
*.sh     text eol=lf
*.py     text eol=lf
*.yaml   text eol=lf
*.yml    text eol=lf
*.toml   text eol=lf
*.md     text eol=lf
*.cfg    text eol=lf
.gitignore      text eol=lf
.gitattributes  text eol=lf

# Data and weights: never touched, never diffed.
*.csv     binary
*.parquet binary
*.ckpt    binary
*.pt      binary
*.safetensors binary
*.png     binary
*.pdf     binary
