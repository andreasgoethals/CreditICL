#!/bin/bash
# Host entrypoint. Every subprocess of Python then stays inside the immutable image.
set -euo pipefail
image=${CREDITICL_RUNTIME_IMAGE:?Activate the accepted PROJECT runtime first}
repo=$(realpath "${VSC_DATA:?}/CreditICL")
assets=${CREDITICL_PROJECT_ROOT:-${VSC_PROJECT_ROOT:-/lustre1/project/stg_00211}}/CreditICL
work=${VSC_SCRATCH_NODE:-${VSC_SCRATCH_LUSTRE1:?}}/CreditICL/runtime-${SLURM_JOB_ID:-login}
mkdir -p "$work/tmp" "$work/cache"
cp /etc/passwd "$work/passwd"
if ! grep -q "^$(id -un):" "$work/passwd"; then getent passwd "$(id -u)" >> "$work/passwd"; fi
cp /etc/group "$work/group"
if ! grep -q "^$(id -gn):" "$work/group"; then getent group "$(id -g)" >> "$work/group"; fi
export TMPDIR="$work/tmp" XDG_CACHE_HOME="$work/cache"
export APPTAINER_CACHEDIR="$work/apptainer-cache" APPTAINER_TMPDIR="$work/tmp"
export PYTHONNOUSERSITE=1
# A submitting login node's config path may not exist on the allocated node.
# Resolve the current host's configuration and bind its real directory too:
# /etc/slurm may contain links into slurmd's configless cache.
unset APPTAINERENV_SLURM_CONF
_slurm_conf=""
for candidate in "${SLURM_CONF:-}" /etc/slurm/slurm.conf /run/slurm/conf/slurm.conf \
    /var/spool/slurmd/conf-cache/slurm.conf /var/spool/slurm/conf-cache/slurm.conf; do
    [[ -n "$candidate" && -f "$candidate" ]] || continue
    _slurm_conf=$(realpath "$candidate")
    break
done
if [[ -n "$_slurm_conf" ]]; then export SLURM_CONF="$_slurm_conf"; else unset SLURM_CONF; fi
for name in CREDITICL_RUNTIME_IMAGE CREDITICL_EXPECTED_COMMIT CREDITICL_PROJECT_ROOT VSC_PROJECT_ROOT \
    VSC_DATA VSC_HOME VSC_SCRATCH VSC_SCRATCH_NODE VSC_SCRATCH_LUSTRE1 VSC_SCRATCH_GPFS1 \
    TMPDIR XDG_CACHE_HOME USER CUDA_VISIBLE_DEVICES PYTHONHASHSEED PYTHONUNBUFFERED PYTHONIOENCODING \
    OMP_NUM_THREADS MKL_NUM_THREADS OPENBLAS_NUM_THREADS NUMEXPR_NUM_THREADS \
    PYTORCH_CUDA_ALLOC_CONF PYTORCH_ALLOC_CONF CREDITICL_DRAW_WORKERS \
    ${!SLURM_@} ${!CREDITICL_@}; do
    [[ ! -v "$name" ]] || export "APPTAINERENV_$name=${!name}"
done
export APPTAINERENV_CREDITICL_IN_CONTAINER=1
export APPTAINERENV_PYTHONNOUSERSITE=1
export APPTAINERENV_PYTHONPATH="$repo"
for cache in HF_HOME TORCH_HOME TRITON_CACHE_DIR TORCHINDUCTOR_CACHE_DIR NUMBA_CACHE_DIR MPLCONFIGDIR; do
    export "APPTAINERENV_$cache=$work/cache/$cache"
done
export APPTAINERENV_LD_LIBRARY_PATH=/opt/compat:/lib64:/usr/lib64:/.singularity.d/libs
_checkout_mode=ro
_maintenance=${CREDITICL_MAINTENANCE:-0}
if [[ "${1:-}" == -m && "${2:-}" == src.utils.clean_run ]]; then
    for flag in "$@"; do [[ "$flag" != --clean ]] || _maintenance=1; done
fi
if [[ "$_maintenance" == 1 ]]; then
    [[ -z "${SLURM_JOB_ID:-}" ]] || { echo 'Writable maintenance is login-only' >&2; exit 1; }
    _queue=$(squeue --clusters=wice,mindwell --me -h -o '%j') || exit 1
    while read -r job; do
        case "$job" in crediticl|crediticl-*|crediticl_*|cicl|cicl-*|cicl_*)
            echo 'Writable maintenance refused while CreditICL jobs are active' >&2; exit 1;;
        esac
    done <<< "$_queue"
    _checkout_mode=rw
fi
runner=(apptainer exec --cleanenv --pwd "$repo" --bind "$repo:$repo:$_checkout_mode"
    --bind "$repo/output CreditICL:$repo/output CreditICL:rw"
    --bind "$assets:$assets:rw" --bind "$work:$work:rw"
    --bind "$work/passwd:/etc/passwd:ro" --bind "$work/group:/etc/group:ro")
for name in VSC_SCRATCH_NODE VSC_SCRATCH_LUSTRE1 VSC_SCRATCH_GPFS1; do
    [[ ! -v "$name" || ! -d "${!name}" ]] || runner+=(--bind "${!name}:${!name}:rw")
done
# Site clients stay host-managed. Bind their non-glibc shared libraries without
# replacing the container's Python, C library or complete /usr tree.
declare -A _bound_libraries=()
for tool in git sbatch squeue sacct scontrol sacctmgr /usr/lib64/slurm/auth_munge.so \
    /usr/lib64/slurm/cli_filter_lua.so /usr/lib64/slurm/serializer*.so /usr/lib64/slurm/data_parser*.so \
    /usr/lib64/lua/5.4/*.so /usr/lib64/lua/5.4/*/*.so; do
    binary=$(command -v "$tool" || true)
    [[ -n "$binary" ]] || continue
    if [[ "$tool" != /usr/lib64/slurm/* && "$tool" != /usr/lib64/lua/* ]]; then runner+=(--bind "$binary:$binary:ro"); fi
    while read -r library; do
        case "$(basename "$library")" in libc.so.*|libm.so.*|libpthread.so.*|libdl.so.*|librt.so.*|libresolv.so.*|ld-linux*) continue;; esac
        if [[ -f "$library" && ! -v "_bound_libraries[$library]" ]]; then
            runner+=(--bind "$library:$library:ro")
            _bound_libraries[$library]=1
        fi
    done < <(ldd "$binary" 2>/dev/null | awk '$2 == "=>" && $3 ~ /^\// {print $3}')
done
for directory in /usr/libexec/git-core /usr/lib64/slurm /usr/lib64/lua /usr/share/lua /etc/slurm /run/slurm /run/munge \
    ${_slurm_conf:+"$(dirname "$_slurm_conf")"}; do
    [[ ! -d "$directory" ]] || runner+=(--bind "$directory:$directory:ro")
done
# Slurm's site Lua filter invokes sam-balance, whose host Python must stay
# separate from /opt/venv. Its native loader and libraries live under a private
# mount; they never replace the scientific interpreter or its C library.
if [[ -x /usr/bin/sam-balance ]]; then
    _site_python=$(realpath /usr/bin/python3)
    _site_version=$(/usr/bin/python3 -c 'import sys; print("{}.{}".format(*sys.version_info[:2]))')
    printf '#!/bin/bash\nexport LD_LIBRARY_PATH=/lib64:/usr/lib64\nexec /opt/vsc-host-libs/ld-linux-x86-64.so.2 --library-path /opt/vsc-host-libs %q "$@"\n' \
        "$_site_python" > "$work/site-python"
    chmod 700 "$work/site-python"
    runner+=(--bind /usr/lib64:/opt/vsc-host-libs:ro
        --bind "$_site_python:$_site_python:ro"
        --bind "$work/site-python:/usr/bin/python3:ro"
        --bind /usr/bin/sam-balance:/usr/bin/sam-balance:ro)
    for directory in "/usr/lib/python$_site_version" "/usr/lib64/python$_site_version"; do
        [[ ! -d "$directory" ]] || runner+=(--bind "$directory:$directory:ro")
    done
fi
# Unit tests write only their temporary output roots; these are inside the work bind.
if [[ -n "${SLURM_JOB_GPUS:-}" || -n "${CUDA_VISIBLE_DEVICES:-}" ]]; then runner+=(--nv); fi
exec "${runner[@]}" "${CREDITICL_EXEC_IMAGE:-$image}" /opt/venv/bin/python "$@"
